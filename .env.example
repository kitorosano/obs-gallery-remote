# Servidor web: 0.0.0.0 permite que otros dispositivos de la LAN accedan al panel.
HOST=0.0.0.0
PORT=3000

# Carpeta de imágenes. Puede ser una ruta absoluta de Windows, por ejemplo C:\\OBS-Gallery.
GALLERY_ROOT=./gallery

# OBS WebSocket debe permanecer accesible solo localmente.
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=change_me

# En una etapa posterior, crear en OBS una fuente de imagen dedicada con este nombre.
OBS_IMAGE_INPUT=OBS_GALLERY_REMOTE
