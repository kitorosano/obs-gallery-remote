{
  "name": "obs-gallery-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Galería móvil local para controlar imágenes en OBS Studio mediante OBS WebSocket.",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --experimental-test-module-mocks --test --test-concurrency=1 test/**/*.test.js",
    "coverage": "c8 --all --include=public/**/*.js --include=server/**/*.js --reporter=text --reporter=html node --experimental-test-module-mocks --test --test-concurrency=1 test/**/*.test.js ",
    "check": "node scripts/check-project.js && node --experimental-test-module-mocks --test --test-concurrency=1 test/**/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "obs-websocket-js": "^5.0.6"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}